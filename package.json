{
  "name": "rahul-project1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Online Food Ordering and Delivery Tracking System with DFA Order Validation",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "dev": "concurrently -k -n backend,frontend -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix backend run dev",
    "dev:client": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
